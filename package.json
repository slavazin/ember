{
  "name": "ember-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quartermaster layer tooling — the corpus derivation and lint scripts.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tools/*.test.ts",
    "gen:check": "node --import tsx tools/index-gen.ts --check",
    "lint": "node --import tsx tools/corpus-lint.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
