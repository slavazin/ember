{
  "name": "ember-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ember layer tooling — the corpus derivation and lint scripts.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tools/*.test.ts tenant-build/tools/*.test.ts tenant-incident/tools/*.test.ts tenant-incident/experiments/*.test.ts",
    "gen:check": "node --import tsx tools/index-gen.ts --check",
    "lint": "node --import tsx tools/corpus-lint.ts",
    "qodo-gate": "node --import tsx tools/qodo-gate.ts",
    "adr": "node --import tsx tenant-build/tools/adr.ts",
    "adr:check": "node --import tsx tenant-build/tools/adr.ts check",
    "incidents:check": "node --import tsx tenant-incident/tools/incidents.ts check",
    "round": "node --import tsx tenant-incident/experiments/run-round.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
